# Motor de IA. Si hay ANTHROPIC_API_KEY se usa la API; si no, la sesión de Claude Code (claude -p).
# ANTHROPIC_API_KEY=
# Opcional: token de un año para el modo sesión. Lo genera y guarda `bash scripts/guardar_token.sh`.
# CLAUDE_CODE_OAUTH_TOKEN=
LEARNVIDEO_MODELO=claude-opus-5
# Tope de gasto de la API en dólares (el modo sesión no cobra por llamada).
LEARNVIDEO_TOPE_USD=20
